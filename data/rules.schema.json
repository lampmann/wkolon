{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wkolon rules pack v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "license",
    "sources",
    "rules",
    "species",
    "classes",
    "skills",
    "feats",
    "talents",
    "equipment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "license": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "revision",
          "url",
          "history",
          "timestamp"
        ]
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "combat": {
          "type": "object",
          "required": [
            "sourceIds",
            "shieldLoss",
            "shieldRecharge",
            "rechargeDC",
            "rechargeActions",
            "naturalHit",
            "naturalMiss",
            "criticalMultiplier",
            "minimumDamage"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "shieldLoss": {
              "type": "integer",
              "minimum": 1
            },
            "shieldRecharge": {
              "type": "integer",
              "minimum": 1
            },
            "rechargeDC": {
              "type": "integer",
              "minimum": 1
            },
            "rechargeActions": {
              "type": "integer",
              "minimum": 1
            },
            "naturalHit": {
              "type": "integer",
              "minimum": 1
            },
            "naturalMiss": {
              "type": "integer",
              "minimum": 1
            },
            "criticalMultiplier": {
              "type": "integer",
              "minimum": 1
            },
            "minimumDamage": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "sourceIds",
            "forcePointBase",
            "xpStep"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "forcePointBase": {
              "type": "integer",
              "minimum": 0
            },
            "xpStep": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "required": [
        "combat",
        "resources"
      ]
    },
    "species": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          }
        ],
        "properties": {
          "isDroid": {
            "type": "boolean",
            "default": false
          },
          "speeds": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "startingFeats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "excludedStartingFeats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "feats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "talents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "destinies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "backgrounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/background"
      }
    },
    "heroicTraits": {
      "type": "object",
      "required": [
        "sourceIds",
        "eras",
        "heroTypes"
      ],
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eras": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heroTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rulePages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "background": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        }
      ],
      "required": [
        "category",
        "relevantSkills",
        "skillChoices",
        "bonusLanguages",
        "untrainedBonus",
        "excludedSpecies"
      ],
      "properties": {
        "category": {
          "enum": [
            "event",
            "occupation",
            "planet"
          ]
        },
        "relevantSkills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "skillChoices": {
          "enum": [
            1,
            2
          ]
        },
        "untrainedBonus": {
          "enum": [
            0,
            2
          ]
        },
        "bonusLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedSpecies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditionalFocus": {
          "type": "string"
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sourceId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+:[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "reference": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "article": {
          "$ref": "#/$defs/article"
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "heading",
        "text",
        "sourceId"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        }
      }
    },
    "article": {
      "type": "object",
      "required": [
        "sourceId",
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wikiNode"
          }
        }
      }
    },
    "wikiNode": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "tag",
            "children"
          ],
          "additionalProperties": false,
          "properties": {
            "tag": {
              "enum": [
                "p",
                "b",
                "i",
                "strong",
                "em",
                "ul",
                "ol",
                "li",
                "dl",
                "dt",
                "dd",
                "table",
                "thead",
                "tbody",
                "tr",
                "th",
                "td",
                "caption",
                "h2",
                "h3",
                "h4",
                "h5",
                "br",
                "sub",
                "sup",
                "blockquote",
                "hr",
                "a"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/wikiNode"
              }
            },
            "href": {
              "type": "string",
              "pattern": "^https://swse\\.miraheze\\.org/wiki/"
            },
            "ruleId": {
              "type": "string",
              "pattern": "^rule:[a-z0-9-]+$"
            },
            "colspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "rowspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        }
      ]
    }
  }
}
